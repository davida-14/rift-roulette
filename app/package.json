{
  "name": "rift-roulette",
  "productName": "Rift Roulette",
  "version": "1.4.1",
  "description": "Random League of Legends item builds (patch 26.10)",
  "main": "main.js",
  "author": "David Fawcett",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "local.riftroulette.app",
    "productName": "Rift Roulette",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "RiftRoulette-Setup-${version}.exe",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rift Roulette"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "davida-14",
        "repo": "rift-roulette",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
